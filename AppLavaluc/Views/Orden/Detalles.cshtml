@model AppLavaluc.Models.Orden
@{
    ViewData["Title"] = "Detalles de Orden";
    var comprobante = Model.Comprobantes?
        .OrderByDescending(c => c.ComprobanteID)
        .FirstOrDefault();
}

<div class="container mt-4 mb-5">
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
            <h4 class="mb-0"><i class="bi bi-receipt me-2"></i> Orden #@Model.OrdenID</h4>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left"></i> Volver al listado
            </a>
        </div>

        <div class="card-body p-4">
            <!-- SECCIÓN 1: DATOS PRINCIPALES -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card bg-light border-0 rounded-4 h-100 p-3">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-primary"><i class="bi bi-person me-2"></i>Cliente</h6>
                            <p class="mb-1"><strong>Nombre:</strong> @Model.Cliente?.NombreCompleto</p>
                            <p class="mb-1"><strong>DNI / Documento:</strong> @(Model.Cliente?.Dni ?? "N/A")</p>
                            <p class="mb-1"><strong>Teléfono:</strong> @(Model.Telefono ?? Model.Cliente?.Telefono ?? "N/A")</p>
                            <p class="mb-0"><strong>Email:</strong> @(Model.Cliente?.Email ?? "N/A")</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card bg-light border-0 rounded-4 h-100 p-3">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-primary"><i class="bi bi-calendar me-2"></i>Información de Entrega</h6>
                            <p class="mb-1"><strong>Recepción:</strong> @Model.FechaRecepcion.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-1"><strong>Entrega Estimada:</strong> @(Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? "Por confirmar")</p>
                            <p class="mb-1"><strong>Tipo Entrega:</strong> <span class="badge bg-info text-dark">@Model.TipoEntrega</span></p>
                            <p class="mb-0"><strong>Estado de Ropa:</strong> <span class="badge bg-success">@Model.Estado</span></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 2: FACTURACIÓN ELECTRÓNICA SUNAT -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-receipt-cutoff text-success me-2"></i> Facturación Electrónica SUNAT
                    </h5>
                    @if (comprobante != null && comprobante.EstadoSunat == "Aceptado")
                    {
                        <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i> Aceptado por SUNAT</span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalFacturarDetalles">
                            <i class="bi bi-send-fill me-1"></i> Emitir Comprobante
                        </button>
                    }
                </div>
                <div class="card-body px-4 pb-4">
                    @if (comprobante != null)
                    {
                        <div class="row align-items-center">
                            <div class="col-md-7">
                                <h4 class="fw-bold text-primary mb-1">@comprobante.TipoDocDescripcion: @comprobante.NumeroCompleto</h4>
                                <p class="text-muted mb-1">
                                    <strong>Fecha de Emisión:</strong> @comprobante.FechaEmision.ToString("dd/MM/yyyy HH:mm") |
                                    <strong>Receptor:</strong> @(comprobante.NumDocCliente ?? "-") - @(comprobante.RznSocialCliente ?? "-")
                                </p>
                                <p class="small text-muted mb-0">
                                    <strong>Gravadas:</strong> S/. @comprobante.MontoOperacionesGravadas.ToString("F2") |
                                    <strong>IGV (18%):</strong> S/. @comprobante.MontoIgv.ToString("F2") |
                                    <strong>Total:</strong> S/. @comprobante.MontoTotal.ToString("F2")
                                </p>
                                @if (!string.IsNullOrWhiteSpace(comprobante.MensajeSunat))
                                {
                                    <div class="small text-muted mt-2"><i class="bi bi-info-circle me-1"></i> @comprobante.MensajeSunat</div>
                                }
                            </div>
                            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                                <div class="d-inline-flex flex-wrap gap-2">
                                    <a asp-controller="Comprobante" asp-action="Imprimir" asp-route-id="@comprobante.ComprobanteID"
                                       target="_blank" class="btn btn-primary rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold" title="Ver / Imprimir formato oficial de Greenter">
                                        <i class="bi bi-printer-fill fs-5"></i>
                                        <span>Imprimir</span>
                                    </a>
                                    <a asp-controller="Comprobante" asp-action="DescargarPdf" asp-route-id="@comprobante.ComprobanteID"
                                       target="_blank" class="btn btn-danger rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold" title="Descargar PDF oficial">
                                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                                        <span>PDF</span>
                                    </a>
                                    <a asp-controller="Comprobante" asp-action="DescargarXml" asp-route-id="@comprobante.ComprobanteID"
                                       class="btn btn-teal rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold text-white" style="background-color: #0d9488;" title="Descargar XML UBL 2.1">
                                        <i class="bi bi-file-earmark-code-fill fs-5"></i>
                                        <span>XML</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Esta orden aún no cuenta con factura o boleta electrónica emitida ante SUNAT. Haz clic en <strong>"Emitir Comprobante"</strong> para generarla en tiempo real.
                        </p>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Observaciones))
            {
                <div class="alert alert-info mb-4 rounded-4">
                    <h6 class="alert-heading fw-bold"><i class="bi bi-chat-left-text me-2"></i>Observaciones</h6>
                    <p class="mb-0">@Model.Observaciones</p>
                </div>
            }

            <!-- SECCIÓN 3: DETALLES DE SERVICIOS -->
            <div class="card mb-4 border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-list-check text-primary me-2"></i>Servicios Incluidos</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Servicio</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end">Descuento</th>
                                    <th class="text-end pe-4">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Detalles != null && Model.Detalles.Count > 0)
                                {
                                    @foreach (var detalle in Model.Detalles)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <strong>@detalle.Servicio?.NombreServicio</strong>
                                                @if (!string.IsNullOrWhiteSpace(detalle.Servicio?.Descripcion))
                                                {
                                                    <br />
                                                    <small class="text-muted">@detalle.Servicio.Descripcion</small>
                                                }
                                            </td>
                                            <td class="text-center">@detalle.Cantidad @detalle.Servicio?.UnidadMedida</td>
                                            <td class="text-end text-muted">S/. @detalle.PrecioUnitario.ToString("F2")</td>
                                            <td class="text-end text-danger small">@(detalle.Descuento > 0 ? "- S/. " + detalle.Descuento.ToString("F2") : "-")</td>
                                            <td class="text-end pe-4 fw-bold">S/. @detalle.Total.ToString("F2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No hay servicios registrados</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 4: RESUMEN FINANCIERO -->
            <div class="row mb-4">
                <div class="col-md-5 offset-md-7">
                    <div class="card border-0 bg-light rounded-4 p-3 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Monto Total:</span>
                                <span class="fw-bold">S/. @Model.MontoTotal.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">A Cuenta (Pagado):</span>
                                <span class="text-success fw-bold">S/. @Model.MontoPagado.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top">
                                <h5 class="mb-0">Saldo Pendiente:</h5>
                                <h5 class="@(Model.SaldoPendiente > 0 ? "text-danger" : "text-muted") fw-bold mb-0">
                                    S/. @Model.SaldoPendiente.ToString("F2")
                                </h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN 5: BOTONES DE ACCIÓN -->
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Lista
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="ImprimirTicket" asp-route-id="@Model.OrdenID" target="_blank" class="btn btn-info rounded-pill px-4 text-white">
                        <i class="bi bi-printer me-1"></i> Ticket Térmico
                    </a>
                    <a asp-action="Editar" asp-route-id="@Model.OrdenID" class="btn btn-warning rounded-pill px-4">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <a asp-action="Eliminar" asp-route-id="@Model.OrdenID" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PARA EMITIR FACTURA / BOLETA DESDE DETALLES -->
<div class="modal fade" id="modalFacturarDetalles" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-controller="Factura" asp-action="Emitir" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrdenId" value="@Model.OrdenID" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title"><i class="bi bi-receipt-cutoff me-2"></i> Emitir Comprobante Electrónico</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted">Tipo de Comprobante</label>
                        <div class="d-flex gap-2">
                            <div class="form-check card-radio w-100">
                                <input class="form-check-input" type="radio" name="TipoDoc" id="modalDetalleBoleta" value="03" checked onchange="toggleTipoDocDetalle()">
                                <label class="form-check-label w-100 p-2 border rounded text-center cursor-pointer" for="modalDetalleBoleta">
                                    <i class="bi bi-person d-block fs-4 mb-1 text-primary"></i>
                                    <strong>Boleta de Venta</strong>
                                    <div class="small text-muted">Serie B001</div>
                                </label>
                            </div>
                            <div class="form-check card-radio w-100">
                                <input class="form-check-input" type="radio" name="TipoDoc" id="modalDetalleFactura" value="01" onchange="toggleTipoDocDetalle()">
                                <label class="form-check-label w-100 p-2 border rounded text-center cursor-pointer" for="modalDetalleFactura">
                                    <i class="bi bi-building d-block fs-4 mb-1 text-success"></i>
                                    <strong>Factura</strong>
                                    <div class="small text-muted">Serie F001</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted" id="labelDetalleDoc">DNI del Cliente</label>
                        <input type="text" name="NumDocCliente" id="inputDetalleDoc" class="form-control bg-light border-0"
                               maxlength="8" value="@Model.Cliente?.Dni" placeholder="DNI (Opcional)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted" id="labelDetalleRzn">Nombre del Cliente</label>
                        <input type="text" name="RznSocialCliente" id="inputDetalleRzn" class="form-control bg-light border-0"
                               value="@Model.Cliente?.NombreCompleto" required />
                    </div>

                    <div class="mb-3 d-none" id="divDetalleDireccion">
                        <label class="form-label fw-bold small text-uppercase text-muted">Dirección Fiscal</label>
                        <input type="text" name="DireccionCliente" class="form-control bg-light border-0"
                               placeholder="Dirección fiscal para factura" />
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-send-fill me-1"></i> Emitir Comprobante
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleTipoDocDetalle() {
            const esFactura = document.getElementById("modalDetalleFactura").checked;
            const labelDoc = document.getElementById("labelDetalleDoc");
            const inputDoc = document.getElementById("inputDetalleDoc");
            const labelRzn = document.getElementById("labelDetalleRzn");
            const divDir = document.getElementById("divDetalleDireccion");

            if (esFactura) {
                labelDoc.innerText = "RUC de la Empresa (11 dígitos)";
                inputDoc.maxLength = 11;
                inputDoc.placeholder = "20XXXXXXXXX";
                labelRzn.innerText = "Razón Social";
                divDir.classList.remove("d-none");
            } else {
                labelDoc.innerText = "DNI del Cliente (8 dígitos / Opcional)";
                inputDoc.maxLength = 8;
                inputDoc.placeholder = "DNI (Opcional)";
                labelRzn.innerText = "Nombre del Cliente";
                divDir.classList.add("d-none");
            }
        }
    </script>
}
